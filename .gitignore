# Secrets / env — keep .env.example committed; never commit real .env
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key

# Logs (general)
*.log

# OS
.DS_Store
Thumbs.db

# Local-only files
LOCAL_NOTES.md

# Benchmark run artifacts (generated locally / in CI)
benchmarks/results/

# TypeScript build cache (regenerated on every build, never commit)
frontend/tsconfig.*.tsbuildinfo

#DB
*.db

# Large binary video files — link to external host instead
# *.mkv # we need videos for deliverables
# *.zip

# Terraform — never commit state or var files containing secrets
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
!terraform/terraform.tfvars.example
# .terraform.lock.hcl is intentionally committed (pins provider versions)

# GCP service account key files — never commit credentials
terraform/*.json
*.json.key
*-credentials.json
gha-creds-*.json
