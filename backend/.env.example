# ============================================================
# TaskOrbit backend — environment template
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. Do NOT commit it.
# ============================================================

# --- Application ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- CORS ---
# Comma-separated list of origins allowed to talk to the FastAPI service.
# In development the Vite dev server runs on :5173.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# Database — PostgreSQL
# ------------------------------------------------------------
# The architecture document defines PostgreSQL as the persistent
# store for chat history, messages, confirmations, agent traces, and
# tool-call results.
#
# When using docker-compose, the `postgres` service in compose.yml
# matches these credentials. When running Postgres yourself, point
# this URL at your local instance.
# ============================================================
DATABASE_URL=postgresql://taskorbit:taskorbit@localhost:5435/taskorbit

# ============================================================
# LiveKit
# ------------------------------------------------------------
# For local dev you can either:
#   (a) use LiveKit Cloud (https://cloud.livekit.io) — free tier is enough
#   (b) run a local LiveKit server with `lk dev` or Docker
# Either way you'll get a URL, an API key, and a secret. The agent
# worker (downstream ticket) will use all three; the frontend only
# needs the URL.
# ============================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Cloud agent dispatch id (often starts with CA_). When set, access
# tokens embed RoomAgentDispatch so this agent joins the room — you can omit
# the local ``taskorbit-worker`` container for voice. See:
# https://docs.livekit.io/agents/server/agent-dispatch/
# LIVEKIT_AGENT_DISPATCH_NAME=CA_nBrjReA5YgFE

# ============================================================
# Speech-to-Text — Deepgram (planned per architecture doc)
# Multilingual model is required (English/German is the initial scope).
# Get a key at https://console.deepgram.com
# ============================================================
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi      # `multi` enables auto language detection

# ============================================================
# Text-to-Speech — ElevenLabs (planned per architecture doc)
# Get a key at https://elevenlabs.io/app/settings/api-keys
# ============================================================
ELEVENLABS_API_KEY=
# Validated voice ID (George). Override per task definition if needed.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# ============================================================
# LLM provider — provider TBD per architecture doc.
# Both OpenAI and Google keys can coexist; downstream code picks one.
# ============================================================
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# ============================================================
# OpenRouter — open-source models (Qwen, Gemma, Llama, Mistral, DeepSeek)
# ------------------------------------------------------------
# Free tier available — no credit card required.
# Get a free API key at: https://openrouter.ai/keys
#
# Free model options (add :free suffix):
#   qwen/qwen3-next-80b-a3b-instruct:free   — Qwen 3 80B MoE
#   google/gemma-4-31b-it:free              — Gemma 4 31B
#   google/gemma-4-26b-a4b-it:free          — Gemma 4 26B MoE
#   openai/gpt-oss-120b:free                — GPT OSS 120B
#   openai/gpt-oss-20b:free                 — GPT OSS 20B
# ============================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# ============================================================
# Ollama — self-hosted inference on Cloud Run with NVIDIA L4 GPU
# ------------------------------------------------------------
# Leave OLLAMA_BASE_URL empty to disable; set to the Cloud Run service URL or
# http://localhost:11434 for a local Ollama instance.
# HTTPS URLs automatically use GCP identity token auth (no extra config needed
# when running on Cloud Run). HTTP URLs are unauthenticated (local dev only).
#
# Deploy: terraform apply -target=module.gpu_inference (enable_gpu_inference=true)
# then terraform apply -target=module.secrets to inject the URL.
# ============================================================
OLLAMA_BASE_URL=https://taskorbit-ollama-inference-gbdc7uznwq-ez.a.run.app/
OLLAMA_MODEL=gemma4:26b

# ============================================================
# Observability
# ------------------------------------------------------------
# METRICS_ENABLED=true exposes a Prometheus /metrics endpoint on the API.
# Set OTEL_ENABLED=true to initialise the OpenTelemetry SDK (stdout exporter
# by default; set OTEL_EXPORTER_OTLP_ENDPOINT to send spans to a collector).
# ============================================================
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================
# APIs — exact APIs TBD per architecture doc.
# Add credentials here once  shared.
# ============================================================
# API_BASE_URL=
# API_KEY=
