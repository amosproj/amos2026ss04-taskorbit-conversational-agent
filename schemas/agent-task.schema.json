{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskorbit.dev/schemas/agent-task.schema.json",
  "title": "TaskOrbit Agent Task Definition",
  "description": "Schema foundation for defining a task and its conversational agent configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "agent"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$",
      "description": "Schema contract version."
    },
    "task": {
      "$ref": "#/$defs/taskDefinition"
    },
    "agent": {
      "$ref": "#/$defs/agentDefinition"
    }
  },
  "$defs": {
    "taskDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "required_inputs",
        "workflow_steps"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inputField"
          }
        },
        "workflow_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workflowStep"
          }
        }
      }
    },
    "agentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "metadata",
        "instruction",
        "first_message",
        "variables",
        "pipeline",
        "tools"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "metadata": {
          "$ref": "#/$defs/agentMetadata"
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "first_message": {
          "$ref": "#/$defs/firstMessage"
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variableField"
          }
        },
        "pipeline": {
          "$ref": "#/$defs/pipelineConfig"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolDefinition"
          },
          "description": "Discriminated union aligned with frontend ToolDefinition (agentConfig.ts)."
        },
        "confirmations": {
          "$ref": "#/$defs/confirmationsConfig",
          "description": "Optional — architecture §4.1 / FE AgentConfig.confirmations."
        },
        "language": {
          "$ref": "#/$defs/languageConfig",
          "description": "Optional — multilingual defaults; FE AgentConfig.language."
        },
        "vad": {
          "$ref": "#/$defs/vadConfig",
          "description": "Optional — voice activity detection; FE AgentConfig.vad."
        },
        "persona_constraints": {
          "$ref": "#/$defs/personaConstraints",
          "description": "Optional scope/refusal guardrails — keeps agent in role on off-topic input (ticket #69)."
        },
        "workflow_dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of agent IDs that must be completed before this agent can be executed."
        },
        "allowed_handoffs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of agent IDs that this agent is allowed to hand off the conversation to."
        },
        "workflow_rules": {
          "type": "array",
          "description": "Conditional workflow branches evaluated after intent routing (Issue #71).",
          "items": {
            "$ref": "#/$defs/workflowRule"
          }
        }
      }
    },
    "workflowRuleWhen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "string",
          "description": "Match when detected intent name equals this value."
        },
        "agent_name": {
          "type": "string",
          "description": "Match when routed agent_name equals this value."
        },
        "else": {
          "type": "boolean",
          "default": false,
          "description": "When true, matches if no prior rule matched in this config."
        }
      }
    },
    "workflowRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "dependencies"],
      "properties": {
        "when": {
          "$ref": "#/$defs/workflowRuleWhen"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agent ids (workflow blocks) that must complete for this branch."
        }
      }
    },
    "confirmationsConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "tools"],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Global switch: whether actions require explicit user confirmation."
        },
        "tools": {
          "type": "array",
          "description": "Allow-list of tool names that bypass confirmation when non-empty semantics apply per product rules.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "languageConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "auto_detect", "supported"],
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1,
          "description": "Default language tag (e.g. BCP-47)."
        },
        "auto_detect": {
          "type": "boolean"
        },
        "supported": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "vadConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "silence_threshold_ms"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["cerebrio", "none"]
        },
        "silence_threshold_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "firstMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message", "prompt"],
      "properties": {
        "type": {
          "type": "string",
          "const": "text",
          "description": "Matches frontend FirstMessage.type — voice UI uses \"text\" today."
        },
        "message": {
          "type": "string",
          "description": "Primary greeting shown/spoken when the session starts."
        },
        "prompt": {
          "type": "string",
          "description": "Optional auxiliary prompt (may be empty)."
        }
      }
    },
    "agentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "persona"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "personaConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "description": "What the agent does — a 1-2 sentence scope statement."
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Domains the agent should politely decline (e.g. 'therapy', 'medical advice')."
        },
        "refusal_template": {
          "type": "string",
          "description": "Verbatim phrase to use when redirecting off-topic input."
        }
      }
    },
    "pipelineConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stt",
        "tts",
        "llm"
      ],
      "properties": {
        "stt": {
          "$ref": "#/$defs/providerConfig"
        },
        "tts": {
          "$ref": "#/$defs/providerConfig"
        },
        "llm": {
          "$ref": "#/$defs/providerConfig"
        }
      }
    },
    "providerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "voice_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolDefinition": {
      "oneOf": [
        {
          "$ref": "#/$defs/dataExtractionTool"
        },
        {
          "$ref": "#/$defs/endCallTool"
        },
        {
          "$ref": "#/$defs/agentTransferTool"
        },
        {
          "$ref": "#/$defs/externalApiTool"
        }
      ]
    },
    "dataExtractionTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "description", "params"],
      "properties": {
        "type": {
          "type": "string",
          "const": "data_extraction"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "array",
          "description": "Matches frontend DataExtractionTool.params (ToolParam[]).",
          "items": {
            "$ref": "#/$defs/toolParameter"
          }
        }
      }
    },
    "endCallTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "description"],
      "properties": {
        "type": {
          "type": "string",
          "const": "end_call"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agentTransferTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "description", "targets"],
      "properties": {
        "type": {
          "type": "string",
          "const": "agent_transfer"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "externalApiTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "description", "parameters"],
      "description": "Generic HTTP-based external tool (#66). Config is interpreted at runtime by taskorbit.tools.generic_api.parse_config; this schema enforces the same shape.",
      "properties": {
        "type": {
          "type": "string",
          "const": "external_api"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "$ref": "#/$defs/externalApiParameters"
        }
      }
    },
    "externalApiParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": {
          "$ref": "#/$defs/externalApiRequest"
        },
        "response": {
          "$ref": "#/$defs/externalApiResponse"
        },
        "auth": {
          "$ref": "#/$defs/externalApiAuth"
        },
        "error_mapping": {
          "type": "object",
          "description": "Per-code message overrides keyed by ERROR_* code (TIMEOUT, HTTP_4XX, etc.).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "args_schema": {
          "type": "object",
          "description": "JSON-Schema-style contract exposed to the LLM so it knows what args to supply."
        }
      }
    },
    "externalApiRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "query": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "$comment": "Untyped: any JSON shape (object, list, string, etc.) allowed."
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "externalApiResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extract": {
          "type": "object",
          "description": "Maps stable output names to dot-paths into the response body.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status_in": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            }
          }
        }
      }
    },
    "externalApiAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_env": {
          "type": "array",
          "description": "Whitelist of env-var names a template may reference via {{env.NAME}}.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "toolParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable_name",
        "type",
        "required"
      ],
      "properties": {
        "variable_name": {
          "type": "string",
          "minLength": 1,
          "description": "Aligned with frontend ToolParam.variable_name (Preet contract)."
        },
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "date", "email", "phone", "location"],
          "description": "Matches frontend ParamType."
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "inputField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "integer",
            "date",
            "email",
            "phone",
            "location"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tool": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        }
      }
    },
    "variableField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "default"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "integer",
            "object",
            "array"
          ]
        },
        "default": {
          "$comment": "Intentionally untyped to support polymorphic default values (string, boolean, object, etc.) as defined by the 'type' field.",
          "description": "Default session value for this variable."
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
